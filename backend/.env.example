# ---- Server ----
PORT=4000
NODE_ENV=development

# ---- Auth ----
# CHANGE THIS in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-in-production-2f8a1c9d4b7e6a3f5c8d1e0b2a4f6c8e
JWT_EXPIRES_IN=8h

# ---- Database ----
# Path is relative to the backend/ folder
DB_FILE=database/military_assets.db

# ---- CORS ----
# Comma-separated list of allowed browser origins. Leave EMPTY for local
# development (this then allows http://localhost:5173 and :4173 only).
# In production set it to your deployed frontend URL, e.g.
#   CORS_ORIGIN=https://military-asset-management-system.vercel.app
# Or several, comma-separated:
#   CORS_ORIGIN=https://my-app.vercel.app,https://my-app.netlify.app
CORS_ORIGIN=
